FROM python:3.10-slim

# Configurar hora correcta servidor
ENV TZ=America/Guayaquil
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone


# Establecer directorio de trabajo
WORKDIR /usr/src/app

# Crear carpeta logs
RUN mkdir -p /usr/src/app /usr/src/app/logs

# Pip con versión fija (no "latest")
RUN pip3 install --no-cache-dir "pip==24.2"

# Solo requirements primero → esta capa queda en caché
COPY requirements.txt .
RUN pip3 install --no-cache-dir --retries 10 --timeout 60 -r requirements.txt \
 || pip3 install --no-cache-dir --retries 10 --timeout 60 -r requirements.txt

# Copiar archivos al contenedor
COPY . /usr/src/app


# Exponer el puerto
EXPOSE 2127

CMD ["gunicorn", "--workers=2", "--worker-connections=400", "--bind", "0.0.0.0:2127", "--worker-class=sync", "--timeout=240", "swagger_server.__main__:app"]
